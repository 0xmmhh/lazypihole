{
	"name": "lazypihole",
	"version": "0.0.0",
	"license": "MIT",
	"bin": "dist/cli.js",
	"type": "module",
	"engines": {
		"node": ">=20"
	},
	"scripts": {
		"build": "tsc",
		"dev": "tsx source/cli.tsx",
		"lint": "biome check .",
		"format": "biome format --write .",
		"check": "biome check . && tsc --noEmit",
		"schema": "tsx scripts/generate-schema.ts && biome format --write source/api/schema.d.ts"
	},
	"files": [
		"dist"
	],
	"dependencies": {
		"dotenv": "^18.0.7",
		"ink": "^4.1.0",
		"meow": "^11.0.0",
		"react": "^18.2.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.15",
		"@sindresorhus/tsconfig": "^3.0.1",
		"@types/node": "^26.6.5",
		"@types/react": "^18.0.32",
		"ava": "^5.2.0",
		"chalk": "^5.2.0",
		"ink-testing-library": "^3.0.0",
		"openapi-typescript": "^7.13.0",
		"tsx": "^4.23.15",
		"typescript": "^5.0.3"
	},
	"ava": {
		"extensions": {
			"ts": "module",
			"tsx": "module"
		},
		"nodeArguments": [
			"--import=tsx"
		]
	}
}
